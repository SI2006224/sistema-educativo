# Configuración para ejecutar el backend localmente
NODE_ENV=development
PORT=3000
DB_STORAGE=../data/database.sqlite
JWT_SECRET=reemplazar-por-un-secreto-local-largo-y-aleatorio
JWT_EXPIRES_IN=24h

# Solo para migrar la base local a Railway. No subir una URL real a Git.
# DATABASE_IMPORT_URL=

# Solo si se ejecuta el seeder inicial en una base vacía.
# INITIAL_ADMIN_PASSWORD=
# INITIAL_PROFESOR_PASSWORD=
